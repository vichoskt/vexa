---
import type { Servicio, Familia } from "../data/servicios";
import { whatsappUrlServicio } from "../lib/contacto";

interface Props {
  servicio: Servicio;
}
const { servicio } = Astro.props;

// Distinción visual por familia, manteniendo la estructura común del grid.
const familiaMeta: Record<Familia, { etiqueta: string; barra: string; punto: string }> = {
  escalera: {
    etiqueta: "Escalera de crecimiento",
    barra: "bg-vx-violet",
    punto: "bg-vx-violet",
  },
  produccion: {
    etiqueta: "Producción",
    barra: "bg-vx-cyan",
    punto: "bg-vx-cyan",
  },
  entrada: {
    etiqueta: "Punto de partida",
    barra: "bg-vx-muted",
    punto: "bg-vx-muted",
  },
};
const meta = familiaMeta[servicio.familia];

const wa = whatsappUrlServicio(servicio.nombre);
const cta = wa ?? "#contacto";
---

<article
  id={servicio.slug}
  class="group relative flex scroll-mt-24 flex-col overflow-hidden rounded-2xl border border-vx-muted/15 bg-white p-6 shadow-sm transition hover:shadow-md"
>
  <span class={`absolute inset-x-0 top-0 h-1 ${meta.barra}`}></span>

  <p class="flex items-center gap-2 font-mono text-xs tracking-[0.12em] text-vx-muted uppercase">
    <span class={`h-1.5 w-1.5 rounded-full ${meta.punto}`} aria-hidden="true"></span>
    {meta.etiqueta}
  </p>

  <h3 class="mt-3 font-display text-xl font-semibold text-vx-ink">
    {servicio.nombre}
  </h3>
  <p class="mt-2 text-sm text-vx-muted text-pretty">{servicio.paraQuien}</p>

  <ul class="mt-5 flex flex-col gap-2.5">
    {
      servicio.alcance.map((punto) => (
        <li class="flex gap-2.5 text-sm text-vx-ink">
          <span class="mt-2 h-1 w-1 flex-none rounded-full bg-vx-violet" aria-hidden="true" />
          <span class="text-pretty">{punto}</span>
        </li>
      ))
    }
  </ul>

  <p class="mt-6 font-mono text-xs text-vx-muted">{servicio.plazo}</p>

  <a
    href={cta}
    {...(wa ? { target: "_blank", rel: "noopener noreferrer" } : {})}
    class="mt-4 inline-flex items-center justify-center gap-1.5 rounded-full border border-vx-ink/15 px-4 py-2.5 text-sm font-medium text-vx-ink transition hover:border-vx-violet hover:text-vx-violet focus-visible:ring-2 focus-visible:ring-vx-ink focus-visible:ring-offset-2 focus-visible:ring-offset-vx-canvas focus-visible:outline-none"
  >
    Pedir propuesta de {servicio.nombre}
    <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
  </a>
</article>
