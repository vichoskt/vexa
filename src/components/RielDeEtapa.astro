---
import { opcionesRiel } from "../data/riel";
import { whatsappUrlServicio } from "../lib/contacto";

const axolotl = `${import.meta.env.BASE_URL}images/axolotl.png`;
---

<section id="riel" class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
  <div class="max-w-2xl">
    <p class="font-mono text-xs tracking-[0.2em] text-vx-violet uppercase">
      Cómo elegir
    </p>
    <h2
      class="mt-4 font-display text-3xl font-semibold text-balance text-vx-ink sm:text-4xl"
    >
      Dime qué necesitas y te digo por dónde partir.
    </h2>
  </div>

  <!-- ── Versión interactiva (solo con JS) ─────────────────────────── -->
  <div data-js data-riel class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-start">
    <div data-tablist-wrap class="relative">
      <div
        role="tablist"
        aria-label="Elige tu situación"
        data-tablist
        class="relative flex flex-col gap-1"
      >
        <span data-rail aria-hidden="true" class="riel-rail"></span>
        <span data-marker aria-hidden="true" class="riel-marker">
          <img src={axolotl} alt="" width="40" height="40" loading="lazy" />
        </span>

        {
          opcionesRiel.map((opcion, i) => (
            <button
              type="button"
              role="tab"
              id={`riel-tab-${i}`}
              aria-controls={`riel-panel-${i}`}
              aria-selected="false"
              tabindex={i === 0 ? 0 : -1}
              data-tab
              data-index={i}
              class="riel-tab group relative flex items-center rounded-xl py-3 pr-4 pl-20 text-left transition"
            >
              <span data-dot class="riel-dot" aria-hidden="true" />
              <span class="font-display text-lg font-medium text-vx-ink">
                {opcion.necesitas}
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="lg:pt-2">
      <p
        data-prompt
        class="rounded-2xl border border-dashed border-vx-muted/30 bg-white/50 px-6 py-8 text-center text-vx-muted"
      >
        Elige una situación a la izquierda y te mostramos qué recomendamos.
      </p>

      {
        opcionesRiel.map((opcion, i) => {
          const wa = whatsappUrlServicio(opcion.servicio.nombre);
          const cta = wa ?? "#contacto";
          return (
            <div
              role="tabpanel"
              id={`riel-panel-${i}`}
              aria-labelledby={`riel-tab-${i}`}
              tabindex="0"
              data-panel
              hidden
              class="rounded-2xl border border-vx-muted/15 bg-white p-6 shadow-sm focus-visible:ring-2 focus-visible:ring-vx-ink focus-visible:outline-none"
            >
              <p class="font-mono text-xs tracking-[0.15em] text-vx-violet uppercase">
                Te recomendamos
              </p>
              <h3 class="mt-2 font-display text-2xl font-semibold text-vx-ink">
                {opcion.servicio.nombre}
              </h3>
              <p class="mt-2 text-vx-muted text-pretty">{opcion.servicio.paraQuien}</p>
              {opcion.nota && (
                <p class="mt-2 text-sm text-vx-muted italic text-pretty">{opcion.nota}</p>
              )}
              <p class="mt-4 font-mono text-sm text-vx-ink">
                Plazo: {opcion.servicio.plazo}
              </p>
              <div class="mt-5 flex flex-col gap-3 sm:flex-row">
                <a
                  href={cta}
                  {...(wa ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  class="inline-flex items-center justify-center rounded-full bg-vx-violet px-5 py-2.5 text-sm font-medium text-white transition hover:brightness-110 focus-visible:ring-2 focus-visible:ring-vx-ink focus-visible:ring-offset-2 focus-visible:ring-offset-vx-canvas focus-visible:outline-none"
                >
                  Pedir propuesta de {opcion.servicio.nombre}
                </a>
                <a
                  href={`#${opcion.servicio.slug}`}
                  class="inline-flex items-center justify-center rounded-full border border-vx-muted/30 px-5 py-2.5 text-sm font-medium text-vx-ink transition hover:border-vx-violet hover:text-vx-violet focus-visible:ring-2 focus-visible:ring-vx-ink focus-visible:ring-offset-2 focus-visible:ring-offset-vx-canvas focus-visible:outline-none"
                >
                  Ver detalle
                </a>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <!-- ── Modo degradado (sin JS): tabla estática con enlaces ───────── -->
  <div data-nojs class="mt-12 overflow-hidden rounded-2xl border border-vx-muted/20">
    <table class="w-full text-left">
      <thead class="bg-vx-ink text-vx-canvas">
        <tr>
          <th class="px-5 py-3 font-mono text-xs tracking-wider uppercase">Si necesitas…</th>
          <th class="px-5 py-3 font-mono text-xs tracking-wider uppercase">Recomendación</th>
        </tr>
      </thead>
      <tbody>
        {
          opcionesRiel.map((opcion) => (
            <tr class="border-t border-vx-muted/15">
              <td class="px-5 py-3 text-vx-ink">{opcion.necesitas}</td>
              <td class="px-5 py-3">
                <a href={`#${opcion.servicio.slug}`} class="font-medium text-vx-violet underline">
                  {opcion.servicio.nombre}
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .riel-rail {
    position: absolute;
    top: 1.25rem;
    bottom: 1.25rem;
    left: 2rem;
    width: 2px;
    transform: translateX(-50%);
    border-radius: 9999px;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-vx-violet) 45%, transparent),
      color-mix(in srgb, var(--color-vx-cyan) 45%, transparent)
    );
  }

  .riel-marker {
    position: absolute;
    left: 2rem;
    top: 0;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 9999px;
    background: var(--color-vx-canvas);
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--color-vx-violet) 60%, transparent),
      0 8px 20px color-mix(in srgb, var(--color-vx-violet) 25%, transparent);
    transform: translate(-50%, -50%) scale(0.6);
    opacity: 0;
    pointer-events: none;
    transition:
      top 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      left 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .riel-marker img {
    width: 2.25rem;
    height: 2.25rem;
    object-fit: contain;
  }
  .riel-marker[data-active] {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .riel-dot {
    position: absolute;
    left: 2rem;
    top: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-vx-muted) 45%, transparent);
    transform: translate(-50%, -50%);
    transition: background 0.2s ease, transform 0.2s ease;
    z-index: 1;
  }
  .riel-tab:hover {
    background: color-mix(in srgb, var(--color-vx-violet) 6%, transparent);
  }
  .riel-tab[aria-selected="true"] .riel-dot {
    background: var(--color-vx-violet);
    transform: translate(-50%, -50%) scale(1.3);
  }
  .riel-tab[aria-selected="true"] {
    background: color-mix(in srgb, var(--color-vx-violet) 8%, transparent);
  }
  .riel-tab:focus-visible {
    outline: 2px solid var(--color-vx-ink);
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    /* En pantallas medianas el riel sigue siendo vertical dentro de su columna;
       el marcador viaja de arriba a abajo junto a las opciones. */
  }

  @media (prefers-reduced-motion: reduce) {
    .riel-marker {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script>
  type El = HTMLElement;

  function initRiel(root: El) {
    const tablist = root.querySelector<El>("[data-tablist]");
    const marker = root.querySelector<El>("[data-marker]");
    const rail = root.querySelector<El>("[data-rail]");
    const prompt = root.querySelector<El>("[data-prompt]");
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panels = Array.from(root.querySelectorAll<El>("[data-panel]"));
    if (!tablist || !marker || !rail || tabs.length === 0) return;

    let current = -1;

    function positionMarker(tab: El) {
      // El marcador vive fijo sobre el eje del riel (left en CSS);
      // solo se desplaza verticalmente hasta el centro de la opción activa.
      const top = tab.offsetTop + tab.offsetHeight / 2;
      marker!.style.top = `${top}px`;
    }

    function activate(index: number, focus = true) {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i]?.toggleAttribute("hidden", !selected);
      });
      const tab = tabs[index];
      if (!tab) return;
      current = index;
      prompt?.setAttribute("hidden", "");
      marker!.setAttribute("data-active", "");
      positionMarker(tab);
      if (focus) tab.focus();
    }

    function moveFocus(from: number, dir: number) {
      const next = (from + dir + tabs.length) % tabs.length;
      tabs[next]?.focus();
      // Solo movemos el foco; la activación es explícita (Enter/Espacio).
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => activate(i, false));
      tab.addEventListener("keydown", (e: KeyboardEvent) => {
        switch (e.key) {
          case "ArrowDown":
          case "ArrowRight":
            e.preventDefault();
            moveFocus(i, 1);
            break;
          case "ArrowUp":
          case "ArrowLeft":
            e.preventDefault();
            moveFocus(i, -1);
            break;
          case "Home":
            e.preventDefault();
            tabs[0]?.focus();
            break;
          case "End":
            e.preventDefault();
            tabs[tabs.length - 1]?.focus();
            break;
          case "Enter":
          case " ":
            e.preventDefault();
            activate(i, false);
            break;
        }
      });
    });

    // Reposicionar el marcador si cambia el tamaño (layout responsivo).
    let raf = 0;
    window.addEventListener("resize", () => {
      if (current < 0) return;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => positionMarker(tabs[current]!));
    });
  }

  document.querySelectorAll<HTMLElement>("[data-riel]").forEach(initRiel);
</script>
