---
import { site } from "../config/site";
import { servicios } from "../data/servicios";
import { whatsappUrl, instagramUrl, correoUrl } from "../lib/contacto";

const wa = whatsappUrl();
const ig = instagramUrl();
const correo = correoUrl();

const base = import.meta.env.BASE_URL;
const accionGracias = `${base}gracias`.replace(/\/{2,}/g, "/");
---

<section id="contacto" class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
  <div class="max-w-2xl">
    <p class="font-mono text-xs tracking-[0.2em] text-vx-violet uppercase">
      Contacto
    </p>
    <h2
      class="mt-4 font-display text-3xl font-semibold text-balance text-vx-ink sm:text-4xl"
    >
      Cuéntanos qué necesitas.
    </h2>
    <p class="mt-4 text-lg text-vx-muted text-pretty">
      Escríbenos y te respondemos con una propuesta a la medida. Sin compromiso
      y sin costo por conversar.
    </p>
  </div>

  <div class="mt-12 grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
    <!-- ── Formulario (Netlify Forms) ─────────────────────────────── -->
    <div>
      <form
        name="contacto"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action={accionGracias}
        data-contact-form
        class="flex flex-col gap-5"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hidden">
          <label>No llenar si eres humano: <input name="bot-field" /></label>
        </p>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5 text-sm font-medium text-vx-ink">
            Nombre
            <input
              type="text"
              name="nombre"
              required
              autocomplete="name"
              class="rounded-xl border border-vx-muted/25 bg-white px-4 py-3 text-base font-normal text-vx-ink transition placeholder:text-vx-muted/60 focus-visible:border-vx-violet focus-visible:ring-2 focus-visible:ring-vx-violet/30 focus-visible:outline-none"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm font-medium text-vx-ink">
            Correo
            <input
              type="email"
              name="correo"
              required
              autocomplete="email"
              class="rounded-xl border border-vx-muted/25 bg-white px-4 py-3 text-base font-normal text-vx-ink transition placeholder:text-vx-muted/60 focus-visible:border-vx-violet focus-visible:ring-2 focus-visible:ring-vx-violet/30 focus-visible:outline-none"
            />
          </label>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5 text-sm font-medium text-vx-ink">
            WhatsApp <span class="font-normal text-vx-muted">(opcional)</span>
            <input
              type="tel"
              name="whatsapp"
              autocomplete="tel"
              class="rounded-xl border border-vx-muted/25 bg-white px-4 py-3 text-base font-normal text-vx-ink transition placeholder:text-vx-muted/60 focus-visible:border-vx-violet focus-visible:ring-2 focus-visible:ring-vx-violet/30 focus-visible:outline-none"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm font-medium text-vx-ink">
            Servicio de interés
            <select
              name="servicio"
              class="rounded-xl border border-vx-muted/25 bg-white px-4 py-3 text-base font-normal text-vx-ink transition focus-visible:border-vx-violet focus-visible:ring-2 focus-visible:ring-vx-violet/30 focus-visible:outline-none"
            >
              <option value="">Aún no lo sé</option>
              {servicios.map((s) => <option value={s.nombre}>{s.nombre}</option>)}
            </select>
          </label>
        </div>

        <label class="flex flex-col gap-1.5 text-sm font-medium text-vx-ink">
          Mensaje
          <textarea
            name="mensaje"
            required
            rows="4"
            class="resize-y rounded-xl border border-vx-muted/25 bg-white px-4 py-3 text-base font-normal text-vx-ink transition placeholder:text-vx-muted/60 focus-visible:border-vx-violet focus-visible:ring-2 focus-visible:ring-vx-violet/30 focus-visible:outline-none"
          ></textarea>
        </label>

        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-full bg-vx-violet px-7 py-3.5 font-medium text-white shadow-lg shadow-vx-violet/20 transition hover:brightness-110 focus-visible:ring-2 focus-visible:ring-vx-ink focus-visible:ring-offset-2 focus-visible:ring-offset-vx-canvas focus-visible:outline-none sm:self-start"
        >
          Pedir propuesta
        </button>
      </form>

      <div
        data-form-success
        hidden
        role="status"
        class="rounded-2xl border border-vx-violet/25 bg-white p-6 text-vx-ink"
      >
        <p class="font-display text-xl font-semibold">¡Listo! Recibimos tu mensaje.</p>
        <p class="mt-2 text-vx-muted text-pretty">
          Te respondemos dentro de 24 a 48 horas hábiles por correo o WhatsApp,
          con los próximos pasos para tu marca.
        </p>
      </div>

      <div
        data-form-error
        hidden
        role="alert"
        class="mt-4 rounded-2xl border border-vx-magenta/30 bg-white p-6 text-vx-ink"
      >
        <p class="font-medium">No pudimos enviar tu mensaje.</p>
        <p class="mt-1 text-vx-muted text-pretty">
          Puedes intentar de nuevo en unos segundos{
            wa ? ", o escribirnos directo por WhatsApp — te respondemos igual." : "."
          }
        </p>
      </div>
    </div>

    <!-- ── Vías alternativas ──────────────────────────────────────── -->
    <aside class="flex flex-col gap-4">
      <p class="text-sm text-vx-muted">¿Prefieres algo más directo?</p>

      {
        wa && (
          <a
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-2xl border border-vx-muted/15 bg-white p-5 transition hover:border-vx-violet focus-visible:ring-2 focus-visible:ring-vx-ink focus-visible:outline-none"
          >
            <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-vx-violet/10 text-vx-violet">
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.548 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413" />
              </svg>
            </span>
            <span>
              <span class="block font-medium text-vx-ink">Escribir por WhatsApp</span>
              <span class="block text-sm text-vx-muted">Respuesta rápida en horario hábil</span>
            </span>
          </a>
        )
      }

      {
        ig && (
          <a
            href={ig}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-2xl border border-vx-muted/15 bg-white p-5 transition hover:border-vx-violet focus-visible:ring-2 focus-visible:ring-vx-ink focus-visible:outline-none"
          >
            <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-vx-violet/10 text-vx-violet">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            </span>
            <span>
              <span class="block font-medium text-vx-ink">Síguenos en Instagram</span>
              <span class="block text-sm text-vx-muted">@{site.instagram}</span>
            </span>
          </a>
        )
      }

      {
        correo && (
          <a
            href={correo}
            class="group flex items-center gap-4 rounded-2xl border border-vx-muted/15 bg-white p-5 transition hover:border-vx-violet focus-visible:ring-2 focus-visible:ring-vx-ink focus-visible:outline-none"
          >
            <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-vx-violet/10 text-vx-violet">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            </span>
            <span>
              <span class="block font-medium text-vx-ink">Escríbenos un correo</span>
              <span class="block text-sm text-vx-muted">{site.correo}</span>
            </span>
          </a>
        )
      }
    </aside>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const success = document.querySelector<HTMLElement>("[data-form-success]");
    const error = document.querySelector<HTMLElement>("[data-form-error]");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      error?.setAttribute("hidden", "");
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) {
        submit.disabled = true;
        submit.textContent = "Enviando…";
      }
      try {
        const body = new URLSearchParams(new FormData(form) as any).toString();
        const res = await fetch(import.meta.env.BASE_URL, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body,
        });
        if (!res.ok) throw new Error(String(res.status));
        form.setAttribute("hidden", "");
        success?.removeAttribute("hidden");
        success?.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch {
        error?.removeAttribute("hidden");
        if (submit) {
          submit.disabled = false;
          submit.textContent = "Pedir propuesta";
        }
      }
    });
  }
</script>
