---
import { sobre } from "../data/sobre";
---

<section id="sobre" class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
  <div class="max-w-3xl">
    <p class="font-mono text-xs tracking-[0.2em] text-vx-violet uppercase">
      Sobre VEXA
    </p>
    <h2
      class="mt-4 font-display text-3xl font-semibold text-balance text-vx-ink sm:text-4xl"
    >
      Ponemos orden antes de recomendar.
    </h2>
    <p class="mt-4 text-lg text-vx-muted text-pretty">{sobre.lead}</p>
  </div>

  <ul class="mt-12 grid gap-6 sm:grid-cols-3">
    {
      sobre.pilares.map((pilar) => (
        <li class="rounded-2xl border border-vx-muted/15 bg-white p-6 shadow-sm">
          <h3 class="font-display text-lg font-semibold text-vx-ink">
            {pilar.titulo}
          </h3>
          <p class="mt-2 text-sm text-vx-muted text-pretty">{pilar.descripcion}</p>
        </li>
      ))
    }
  </ul>
</section>
